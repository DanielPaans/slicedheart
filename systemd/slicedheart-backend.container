[Unit]
Description=SlicedHeart Backend Flask Service
After=slicedheart-pod.service

[Container]
ContainerName=slicedheart-backend
Image=localhost/slicedheart-backend
Pod=slicedheart.pod
Environment=FLASK_ENV=production
Environment=PORT=${BACKEND_PORT}
PodmanArgs=--shm-size=2g

[Service]
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

[Install]
WantedBy=default.target